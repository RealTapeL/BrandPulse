# BrandPulse 本地开发环境变量示例
# 复制为 .env 并按需修改

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brandpulse
POSTGRES_PASSWORD=brandpulse123
POSTGRES_DB=brandpulse

# Redis（任务队列）
REDIS_URL=redis://127.0.0.1:6379/0

# Web 登录（local 模式允许任意非空凭据，仅限本地单团队开发）
AUTH_MODE=local
# AUTH_SECRET=please-generate-a-long-random-secret
# AUTH_TOKEN_TTL_SECONDS=28800
# AUTH_USERNAME=
# AUTH_PASSWORD=
ALERT_SCHEDULER_ENABLED=true
ALERT_INTERVAL_MINUTES=5
MONITORING_SCHEDULER_ENABLED=true
MONITORING_SCHEDULER_INTERVAL_SECONDS=60

# LLM / Embedding（OpenAI 兼容接口）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-key
LLM_MODEL=gpt-4o-mini

# 高德 API
AMAP_KEY=

# Agent-Reach 外部公开信息研究（默认关闭）
AGENT_REACH_ENABLED=false
AGENT_REACH_COMMAND=agent-reach
AGENT_REACH_SEARCH_COMMAND=mcporter
AGENT_REACH_TIMEOUT_SECONDS=30
AGENT_REACH_MAX_RESPONSE_CHARS=12000
