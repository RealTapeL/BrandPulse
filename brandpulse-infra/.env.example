# 复制本文件为 .env 后修改
# cp .env.example .env

# 本机 IP（Neo4j advertised address 用，从其他机器访问 Neo4j 时需要）
# 查看命令：hostname -I | awk '{print $1}'
HOST_IP=192.168.x.x

# PostgreSQL 配置
POSTGRES_USER=brandpulse
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=brandpulse
POSTGRES_PORT=5432

# Neo4j 配置（格式：用户名/密码）
NEO4J_AUTH=neo4j/your_strong_password
NEO4J_HTTP_PORT=8484
NEO4J_BOLT_PORT=8585

# Qdrant 配置
QDRANT_HTTP_PORT=7333
QDRANT_GRPC_PORT=7334
