# BrandPulse Python 侧配置
# 全系统唯一数据库是 PostgreSQL
# 数据库在其他机器时，把 localhost 换成该机器的 IP

# PostgreSQL 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brandpulse
POSTGRES_PASSWORD=brandpulse123
POSTGRES_DB=brandpulse

# Web 登录。local 为单团队本地模式；生产请设为 password 并配置独立凭据。
AUTH_MODE=local
# 生产环境必须配置随机长字符串；不配置时令牌密钥仅在当前进程内有效
# AUTH_SECRET=please-generate-a-long-random-secret
# AUTH_TOKEN_TTL_SECONDS=28800
# AUTH_USERNAME=
# AUTH_PASSWORD=

# 告警调度与真实通知（未配置 SMTP/webhook 时会明确失败，不会返回 mock_sent）
ALERT_SCHEDULER_ENABLED=true
ALERT_INTERVAL_MINUTES=5
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@example.com
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# SMTP_USE_TLS=true

# 自动采集/报告计划由独立调度进程负责；计划本身仍默认关闭
MONITORING_SCHEDULER_ENABLED=true
MONITORING_SCHEDULER_INTERVAL_SECONDS=60

# 高德地图 API Key
# 申请地址：https://console.amap.com
AMAP_KEY=

# 高德 Web端(JS API) Key + 安全密钥（Loca 数据可视化 / 门店分布地图页用）
# 在控制台同一应用下新建"Web端(JS API)"类型的 Key，安全密钥在该 Key 的"设置"里
AMAP_JS_KEY=
AMAP_JS_SECRET=

# LLM / Embedding 配置（OpenAI 兼容接口）
# 示例：硅基流动 / DeepSeek / 通义 / OpenAI 等
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your_llm_key_here
LLM_MODEL=gpt-4o-mini

EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=your_embedding_key_here
EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_VECTOR_SIZE=1536

# 第三方搜索 API（BettaFish 思路，避免直接浏览器访问社媒平台）
# 国内推荐 Bocha: https://open.bocha.cn
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search
# 国际推荐 Tavily: https://tavily.com
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search

# Agent-Reach 外部公开信息研究（默认关闭；不替代真实指标采集）
AGENT_REACH_ENABLED=false
AGENT_REACH_COMMAND=agent-reach
AGENT_REACH_SEARCH_COMMAND=mcporter
AGENT_REACH_TIMEOUT_SECONDS=30
AGENT_REACH_MAX_RESPONSE_CHARS=12000

# 本地文件缓存配置
# 设置为 1/true/yes 可完全禁用 PostgreSQL 的 metrics 写入，只用 JSONL 文件缓存
DISABLE_METRICS_DB=false
# 本地缓存目录，默认 data/processed/
METRICS_CACHE_DIR=data/processed
