# BrandPulse Python 侧配置
# 端口需与 brandpulse-infra/.env 中的映射端口一致
# 数据库在其他机器时，把 localhost 换成该机器的 IP

# PostgreSQL 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brandpulse
POSTGRES_PASSWORD=brandpulse123
POSTGRES_DB=brandpulse

# Neo4j 配置
NEO4J_URI=bolt://localhost:8585
NEO4J_USER=neo4j
NEO4J_PASSWORD=brandpulse123

# Qdrant 配置
QDRANT_HOST=localhost
QDRANT_PORT=7333
# 本地嵌入模式（免 Docker / 免 Qdrant 服务）：设置后忽略上面的 host/port
# 相对路径基于项目根目录；留空则走服务器模式
QDRANT_PATH=brandpulse-infra/data/qdrant-local

# 高德地图 API Key
# 申请地址：https://console.amap.com
AMAP_KEY=

# LLM / Embedding 配置（OpenAI 兼容接口）
# 示例：硅基流动 / DeepSeek / 通义 / OpenAI 等
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your_llm_key_here
LLM_MODEL=gpt-4o-mini

EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=your_embedding_key_here
EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_VECTOR_SIZE=1536

# 第三方搜索 API（BettaFish 思路，避免直接浏览器访问社媒平台）
# 国内推荐 Bocha: https://open.bocha.cn
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search
# 国际推荐 Tavily: https://tavily.com
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search

# 本地文件缓存配置
# 设置为 1/true/yes 可完全禁用 PostgreSQL 的 metrics 写入，只用 JSONL 文件缓存
DISABLE_METRICS_DB=false
# 本地缓存目录，默认 data/processed/
METRICS_CACHE_DIR=data/processed
