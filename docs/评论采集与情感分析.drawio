<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="22.1.11">
  <diagram id="review-sentiment" name="详情页评论采集与情感分析">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="BrandPulse 详情页评论采集 + 情感分析 数据流" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="450" height="40" as="geometry" />
        </mxCell>

        <!-- 输入层 -->
        <mxCell id="input" value="输入命令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="input_cmd" value="python main.py crawl --mall 苏州中心 --category 咖啡 --detail" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- 判断：是否详情模式 -->
        <mxCell id="check_detail" value="--detail 是否开启？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="105" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- 列表页路径 -->
        <mxCell id="list_flow" value="仅采集搜索列表页\n(当前第一阶段)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- 详情页路径 -->
        <mxCell id="detail_flow" value="进入详情页采集评论\n(第二阶段)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- 大众点评详情 extractor -->
        <mxCell id="dp_detail" value="DianpingDetailExtractor\n门店详情页 + 评论列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="170" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- 小红书详情 extractor -->
        <mxCell id="xhs_detail" value="XhsDetailExtractor\n笔记详情页 + 评论区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- 评论原始表 -->
        <mxCell id="raw_tables" value="评论原始表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- dp_reviews 表 -->
        <mxCell id="dp_reviews" value="dp_reviews\n\nreview_id (PK)\nshop_name\ncity\nmall_name\nbrand_id\nreviewer\nrating\ncontent\nreview_time\nlikes\ncrawl_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- xhs_comments 表 -->
        <mxCell id="xhs_comments" value="xhs_comments\n\ncomment_id (PK)\nnote_id (FK→xhs_notes)\nauthor_name\ncontent\ncomment_time\nlikes\ncrawl_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- 情感分析层 -->
        <mxCell id="sentiment" value="SentimentAnalyzer\n情感分析引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sentiment_desc" value="- 文本清洗/分词\n- 情感打分 (-1~1)\n- 关键词提取\n- 调用 LLM 或本地模型" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="320" y="490" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 情感结果表 -->
        <mxCell id="sentiment_results" value="sentiment_results\n\nresult_id (PK)\nsource_type (dp_review/xhs_comment)\nsource_id\ncontent\nsentiment_score\nsentiment_label\nkeywords\nanalyzed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="560" y="420" width="180" height="150" as="geometry" />
        </mxCell>

        <!-- 聚合输出层 -->
        <mxCell id="output" value="聚合与看板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="620" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="output_desc" value="- brand_heat_daily 增加 sentiment 字段\n- Superset 新增情感分布图表\n- 负面评论预警" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="320" y="680" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- 现有表关联 -->
        <mxCell id="existing" value="关联现有表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="existing_list" value="xhs_notes\nbrand_heat_daily\ndp_shop_metrics" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="input" target="check_detail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="check_detail" target="list_flow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2label" value="否" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="-0.8" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="check_detail" target="detail_flow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3label" value="是" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="e3">
          <mxGeometry x="-0.8" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="detail_flow" target="dp_detail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="detail_flow" target="xhs_detail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="dp_detail" target="dp_reviews">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="xhs_detail" target="xhs_comments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="dp_reviews" target="sentiment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="xhs_comments" target="sentiment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="sentiment" target="sentiment_results">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="sentiment_results" target="output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" edge="1" parent="1" source="xhs_comments" target="existing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12label" value="note_id → xhs_notes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;" vertex="1" connectable="0" parent="e12">
          <mxGeometry x="-0.6" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" edge="1" parent="1" source="dp_reviews" target="existing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13label" value="shop_name/brand_id → dp_shop_metrics" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;" vertex="1" connectable="0" parent="e13">
          <mxGeometry x="-0.6" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
