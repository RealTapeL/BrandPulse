                </mxCell>
                <mxCell id="step5-chunk" value="&lt;b&gt;Chunk表&lt;/b&gt;&lt;br&gt;knowledge_chunks&lt;br&gt;+ chunk_embeddings&lt;br&gt;&lt;br&gt;存储非结构化文本&lt;br&gt;和向量化内容&lt;br&gt;供LLM/RAG使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.5;arcSize=6;fontSize=12;" parent="1" vertex="1">
