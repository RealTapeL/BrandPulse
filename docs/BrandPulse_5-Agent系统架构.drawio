<mxfile host="app.diagrams.net" modified="2026-07-30T00:00:00.000Z" agent="Kimi" version="21.0.0" etag="brandpulse-agent-harness" type="device">
  <diagram name="BrandPulse 自建 Agent Harness 系统架构" id="brandpulse-agent-harness-arch">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BrandPulse 自建 Agent Harness 系统架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="1200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="input" value="用户提问 / 对话界面（Vue3 前端）&lt;br&gt;“苏州中心咖啡店这个月口碑怎么样？”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;arcSize=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="800" height="60" as="geometry" />
        </mxCell>

        <mxCell id="harness-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="210" width="1500" height="400" as="geometry" />
        </mxCell>
        <mxCell id="harness-title" value="&lt;b&gt;Agent Harness（自建脚手架）—— LLM 只负责调度与表达，不做计算&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#EA580C;" vertex="1" parent="1">
          <mxGeometry x="800" y="220" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;LLM 决策核心&lt;/b&gt;&lt;br&gt;模型 API（Kimi / 其他）&lt;br&gt;理解意图、选择工具、组织语言" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="260" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="&lt;b&gt;ReAct 循环（harness 的心脏）&lt;/b&gt;&lt;br&gt;思考 → 调用工具 → 观察结果 → 再思考&lt;br&gt;直到任务完成或达到步数上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1410" y="260" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;工具注册表 Tool Registry&lt;/b&gt;&lt;br&gt;每个工具：名称 / 参数 schema / 文档说明&lt;br&gt;LLM 按说明决定何时调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="380" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="memory" value="&lt;b&gt;上下文与记忆管理&lt;/b&gt;&lt;br&gt;对话压缩 / 会话记忆 / 历史摘要&lt;br&gt;长任务不“失忆”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1410" y="380" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="permission" value="&lt;b&gt;权限层&lt;/b&gt;&lt;br&gt;只读工具直接执行；&lt;br&gt;写入/采集等动作可要求人工确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="500" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;审计日志&lt;/b&gt;&lt;br&gt;记录每步决策与工具调用（可回放）&lt;br&gt;支撑结果可追溯、可审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1410" y="500" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="harness-inner-link" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=1;dashed=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="llm" target="loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="tools-title" value="&lt;b&gt;工具层 = 现有代码封装（原 5 个 Agent 降级为工具组，由 Harness 统一调度）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1">
          <mxGeometry x="700" y="640" width="1000" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tool-crawl" value="&lt;b&gt;采集工具 crawl&lt;/b&gt;&lt;br&gt;crawl(mall, category)&lt;br&gt;WebBridge 驱动真实浏览器&lt;br&gt;大众点评 / 小红书" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="690" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tool-search" value="&lt;b&gt;网页搜索工具&lt;/b&gt;&lt;br&gt;web_search(query)&lt;br&gt;实时查新：融资 / 拓店&lt;br&gt;关店 / 高管动态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="690" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tool-sql" value="&lt;b&gt;数据查询工具&lt;/b&gt;&lt;br&gt;query_db(sql) 只读&lt;br&gt;NL → SQL&lt;br&gt;查事实、不编造" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#059669;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="690" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tool-indicators" value="&lt;b&gt;指标计算工具&lt;/b&gt;&lt;br&gt;run_indicators(date)&lt;br&gt;口碑 / 热度 / SOV&lt;br&gt;确定性代码，可复现可审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="690" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tool-report" value="&lt;b&gt;报告与图表工具&lt;/b&gt;&lt;br&gt;render_chart / gen_report&lt;br&gt;ECharts 看板 / 招商简报&lt;br&gt;按模板渲染多格式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="690" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="data-layer" value="&lt;b&gt;数据层&lt;/b&gt;&lt;br&gt;PostgreSQL：dp_shop_metrics / xhs_notes / brand_indicators_daily&lt;br&gt;JSON 缓存（原始响应，可重放）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="880" width="740" height="90" as="geometry" />
        </mxCell>

        <mxCell id="output" value="&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;招商简报 / 品牌档案 / 风险预警报告&lt;br&gt;（附带数据来源引用，可追溯）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="880" width="680" height="90" as="geometry" />
        </mxCell>

        <mxCell id="input-to-llm" value="提问" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="input" target="harness-bg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="harness-to-crawl" value="调用 / 返回结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=11;" edge="1" parent="1" source="tool-crawl" target="harness-bg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="harness-to-search" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="tool-search" target="harness-bg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="harness-to-sql" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="tool-sql" target="harness-bg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="harness-to-indicators" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="tool-indicators" target="harness-bg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="harness-to-report" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="tool-report" target="harness-bg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="crawl-to-data" value="写入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="tool-crawl" target="data-layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sql-to-data" value="只读查询" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="tool-sql" target="data-layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="indicators-to-data" value="读原始表 / 写指标表" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=11;" edge="1" parent="1" source="tool-indicators" target="data-layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="report-to-output" value="渲染" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="tool-report" target="output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;说明&lt;/b&gt;&lt;br&gt;• 与原“5-Agent 流水线”的区别：不再有 5 个各自为政的 Agent，而是 1 个 Harness（LLM + ReAct 循环）统一调度 5 个工具组&lt;br&gt;• 确定性原则：采集、SQL 查询、指标计算全部走代码，LLM 只做“调哪个工具、怎么组织结论”，指标可复现可审计&lt;br&gt;• 工具即现有代码：crawl = main.py 采集流程，run_indicators = src/backend/brandpulse/indicators/，query_db = PostgreSQL 只读连接&lt;br&gt;• 权限层保证只读操作自由执行，写库 / 发起采集等动作可配置人工确认&lt;br&gt;• 阶段规划：先封装 4 个只读工具（查询/指标/搜索/图表）跑通对话，再接入采集与报告生成" style="text;html=1;strokeColor=none;fillColor=#F8FAFC;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;fontColor=#334155;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="1010" width="1620" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
