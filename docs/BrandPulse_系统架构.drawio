        <mxCell id="e-worker-domain" value="执行 Agent / ML / 报告 Runner" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="worker" target="domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-public-bridge" value="浏览器会话 / API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="public-sources" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-internal-bridge" value="Excel / API / 数据库连接器（规划）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="internal-sources" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
