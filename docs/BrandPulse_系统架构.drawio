        <mxCell id="e-domain-qwen" value="模型只负责理解与表达" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="domain" target="qwen"><mxGeometry relative="1" as="geometry"/></mxCell>
