        <mxCell id="e-bridge-landing" value="不可变原始快照" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="bridge" target="landing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-governance-pg" value="通过校验后入库" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="governance" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-pg-derived" value="聚合 / 确定性计算" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="postgres" target="derived"><mxGeometry relative="1" as="geometry"/></mxCell>
