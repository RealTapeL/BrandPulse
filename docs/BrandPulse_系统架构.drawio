<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="brandpulse-product-architecture" name="产品化目标架构">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BrandPulse 产品化目标架构与当前实现边界（2026-08-14）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="640" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="当前可用能力以实线表示；后续产品化能力以虚线表示。所有业务结论必须能回溯到数据来源、采集批次、质量状态和指标版本。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="55" width="1100" height="26" as="geometry"/></mxCell>

        <mxCell id="user-layer" value="用户与访问层" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="330" height="175" as="geometry"/></mxCell>
        <mxCell id="user" value="招商 / 运营 / 管理人员&#xa;查看看板、配置监测、导出报告、追踪任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="user-layer"><mxGeometry x="20" y="48" width="290" height="62" as="geometry"/></mxCell>
        <mxCell id="frontend" value="Vue 3 Web 平台&#xa;登录 · 看板 · 品牌 · 数据表 · 治理&#xa;监控 · 报告 · Agent · ML · 操作审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="user-layer"><mxGeometry x="20" y="120" width="290" height="42" as="geometry"/></mxCell>

        <mxCell id="api-layer" value="应用与领域服务层（模块化单体）" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="690" height="175" as="geometry"/></mxCell>
        <mxCell id="api" value="FastAPI API / 鉴权 / 审计入口&#xa;REST /api/v1 · OpenAPI · 统一错误与权限边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="api-layer"><mxGeometry x="20" y="48" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="domain" value="领域服务&#xa;监测范围 · 采集任务 · 数据治理 · 指标公式&#xa;告警 · 报告 · ML · Agent · 对话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="api-layer"><mxGeometry x="350" y="48" width="315" height="62" as="geometry"/></mxCell>
        <mxCell id="auth-audit" value="当前：Bearer 鉴权 + 请求级操作审计；后续：组织 / 角色 / 数据权限 · 限流 · 幂等键" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="api-layer"><mxGeometry x="20" y="120" width="645" height="34" as="geometry"/></mxCell>

        <mxCell id="external-ai" value="外部智能与研究依赖" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="100" width="370" height="175" as="geometry"/></mxCell>
        <mxCell id="qwen" value="阿里云百炼 Qwen&#xa;当前：qwen3.7-plus&#xa;规划：max / flash / text-embedding 路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="external-ai"><mxGeometry x="20" y="48" width="330" height="62" as="geometry"/></mxCell>
        <mxCell id="reach" value="Agent-Reach（可选）&#xa;公开网页研究，不写入核心指标&#xa;必须保留来源 URL、时间和引用" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;" vertex="1" parent="external-ai"><mxGeometry x="20" y="120" width="330" height="42" as="geometry"/></mxCell>

        <mxCell id="async-layer" value="异步任务与调度层" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="690" height="190" as="geometry"/></mxCell>
        <mxCell id="scheduler" value="独立调度器&#xa;Monitoring：采集 / 报告&#xa;Alerts：告警检查 / 通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="async-layer"><mxGeometry x="20" y="50" width="205" height="80" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis + RQ&#xa;brandpulse-crawl&#xa;brandpulse-agent / ml / report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="async-layer"><mxGeometry x="245" y="50" width="195" height="80" as="geometry"/></mxCell>
        <mxCell id="worker" value="RQ Worker / Task Runner&#xa;采集、Agent、ML、报告分别执行&#xa;失败按上限重试并记录原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="async-layer"><mxGeometry x="460" y="50" width="205" height="80" as="geometry"/></mxCell>
        <mxCell id="async-hardening" value="产品化补强：任务超时 / 死信队列 / 取消任务 / 资源隔离 / 运行指标 / 调度器单实例选主" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff5f5;strokeColor=#b85450;" vertex="1" parent="async-layer"><mxGeometry x="20" y="142" width="645" height="28" as="geometry"/></mxCell>

        <mxCell id="ingest-layer" value="数据接入与治理层" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="760" height="265" as="geometry"/></mxCell>
        <mxCell id="public-sources" value="当前公开来源&#xa;大众点评 / 小红书：WebBridge 已登录浏览器会话&#xa;高德：API / POI 采集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ingest-layer"><mxGeometry x="20" y="48" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="internal-sources" value="后续内部来源&#xa;POS 销售 · 合同租金 · 客流 · 会员&#xa;客诉巡检 · 招商联系记录" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f8f8;strokeColor=#9673a6;" vertex="1" parent="ingest-layer"><mxGeometry x="20" y="150" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="bridge" value="WebBridge / API / Excel Connector&#xa;站点配置 · extractor 插件&#xa;重试、超时、来源级结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="ingest-layer"><mxGeometry x="270" y="48" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="governance" value="标准化与数据治理&#xa;schema 校验 · 去重 · 品牌 / 门店匹配&#xa;质量扫描 · 血缘 · 问题确认与关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="ingest-layer"><mxGeometry x="520" y="48" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="landing" value="原始落地区&#xa;开发：data/raw + data/processed JSON&#xa;生产：对象存储 / MinIO（规划）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f8f8;strokeColor=#9673a6;" vertex="1" parent="ingest-layer"><mxGeometry x="270" y="150" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="ingest-contract" value="每条记录保留 source、crawl_run、captured_at、原始键和质量状态；失败 / 空结果不能伪装成成功。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="ingest-layer"><mxGeometry x="20" y="238" width="720" height="20" as="geometry"/></mxCell>

        <mxCell id="data-layer" value="数据与计算层" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="570" width="700" height="265" as="geometry"/></mxCell>
        <mxCell id="postgres" value="PostgreSQL 主数据与业务库&#xa;维度：brands / stores / malls / category_dict&#xa;原始：dp_shop_metrics / xhs_notes + record lineage&#xa;治理：aliases / quality / source logs / audit events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="data-layer"><mxGeometry x="20" y="48" width="315" height="112" as="geometry"/></mxCell>
        <mxCell id="derived" value="确定性指标层&#xa;brand_heat_daily · brand_indicators_daily&#xa;口碑 / 热度 / SOV / 趋势 / 自定义公式&#xa;保留公式参数与 detail，支持重算和解释" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="data-layer"><mxGeometry x="365" y="48" width="315" height="112" as="geometry"/></mxCell>
        <mxCell id="ml" value="机器学习层&#xa;数据集上传 · 校验 · 训练 · 回测 · 模型版本&#xa;预测 · 导出 · 训练 / 导出日志&#xa;内部数据通过资格门禁后才可用于生产" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="data-layer"><mxGeometry x="20" y="178" width="315" height="62" as="geometry"/></mxCell>
        <mxCell id="product-output" value="产品输出层&#xa;看板 · 品牌详情 · 数据表 · 报告&#xa;告警历史 / 通知 · Agent 可解释回答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="data-layer"><mxGeometry x="365" y="178" width="315" height="62" as="geometry"/></mxCell>

        <mxCell id="ops-layer" value="生产运维与安全（上线前必须补齐）" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="1510" height="150" as="geometry"/></mxCell>
        <mxCell id="deploy" value="当前：数据库迁移 · 备份校验 · 每日 timer 模板&#xa;后续：反向代理 / TLS / 容器化&#xa;密钥管理 · 异机恢复 · 对象存储" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="ops-layer"><mxGeometry x="20" y="48" width="280" height="72" as="geometry"/></mxCell>
        <mxCell id="observability" value="当前：结构化日志 · request/run/job ID&#xa;健康探针 · Prometheus HTTP 指标&#xa;后续：Grafana · 队列指标 · 错误聚合" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="ops-layer"><mxGeometry x="330" y="48" width="280" height="72" as="geometry"/></mxCell>
        <mxCell id="notification" value="通知中心：SMTP / Webhook&#xa;告警去重、抑制、恢复通知&#xa;逐目标投递记录与失败重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="ops-layer"><mxGeometry x="640" y="48" width="280" height="72" as="geometry"/></mxCell>
        <mxCell id="governance-product" value="治理制度：数据字典 / 指标版本&#xa;权限审批 / 脱敏 / 留存周期&#xa;内部经营数据不可被公开数据替代" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="ops-layer"><mxGeometry x="950" y="48" width="280" height="72" as="geometry"/></mxCell>
        <mxCell id="legend" value="图例：实线 = 当前代码已具备或当前可运行；虚线 = 后续产品化功能 / 生产依赖；Agent-Reach 与公开平台只提供辅助信息，不是内部经营数据事实源。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="ops-layer"><mxGeometry x="1240" y="48" width="250" height="72" as="geometry"/></mxCell>

