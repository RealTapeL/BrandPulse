  <diagram id="brandpulse-current-data-model" name="当前数据模型">
    <mxGraphModel dx="1420" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BrandPulse 当前数据模型与数据流（2026-07-31）" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="650" height="30" as="geometry"/></mxCell>
        <mxCell id="note" value="说明：公开平台数据当前用于品牌口碑、热度和竞争线索；POS 销售、合同、客流等内部营运数据尚未接入，不应把公开平台评价数据等同为项目经营数据。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="100" y="55" width="1080" height="25" as="geometry"/></mxCell>
        <mxCell id="master" value="主数据 / 维度" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="355" as="geometry"/></mxCell>
        <mxCell id="brands" value="brands&#xa;品牌档案：品类、定位、价格带、拓店状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="master"><mxGeometry x="18" y="42" width="224" height="58" as="geometry"/></mxCell>
        <mxCell id="category" value="category_dict&#xa;购物中心业态三级分类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="master"><mxGeometry x="18" y="115" width="224" height="52" as="geometry"/></mxCell>
        <mxCell id="stores" value="stores&#xa;高德采集的品牌门店、城市、商场、坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="master"><mxGeometry x="18" y="182" width="224" height="58" as="geometry"/></mxCell>
        <mxCell id="malls" value="malls&#xa;商场主数据，采集点评时自动登记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="master"><mxGeometry x="18" y="255" width="224" height="52" as="geometry"/></mxCell>
        <mxCell id="raw" value="公开数据原始表" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="355" y="110" width="310" height="355" as="geometry"/></mxCell>
        <mxCell id="dp" value="dp_shop_metrics&#xa;店名、城市、商场、评分、评价数、人均、采集日&#xa;主键：店名 + 城市 + 采集日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="raw"><mxGeometry x="18" y="42" width="274" height="78" as="geometry"/></mxCell>
        <mxCell id="xhs" value="xhs_notes&#xa;笔记、作者、点赞、发布时间、关键词、采集日&#xa;主键：note_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="raw"><mxGeometry x="18" y="138" width="274" height="72" as="geometry"/></mxCell>
        <mxCell id="json" value="data/processed/*.json&#xa;原始结果本地缓存，用于追溯与排查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="raw"><mxGeometry x="18" y="230" width="274" height="58" as="geometry"/></mxCell>
        <mxCell id="aggregate" value="聚合与指标表" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="350" height="355" as="geometry"/></mxCell>
        <mxCell id="heat" value="brand_heat_daily&#xa;品牌/采集批次 × 城市 × 商场 × 日期 × 平台&#xa;小红书提及与点赞；点评评价数、门店数、人均" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="aggregate"><mxGeometry x="18" y="42" width="314" height="75" as="geometry"/></mxCell>
        <mxCell id="indicator" value="brand_indicators_daily&#xa;门店或商场级的口碑、热度、SOV、动量、波动率&#xa;保留 detail JSON，方便解释计算过程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="aggregate"><mxGeometry x="18" y="137" width="314" height="78" as="geometry"/></mxCell>
        <mxCell id="legacy" value="indicators&#xa;品牌维度时序查询表（现有品牌详情兼容读取）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="aggregate"><mxGeometry x="18" y="235" width="314" height="52" as="geometry"/></mxCell>
        <mxCell id="web" value="Web 平台业务表" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1125" y="110" width="245" height="355" as="geometry"/></mxCell>
        <mxCell id="crawl" value="crawl_jobs&#xa;采集任务状态与结果摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="web"><mxGeometry x="15" y="42" width="215" height="52" as="geometry"/></mxCell>
        <mxCell id="agent" value="agent_tasks&#xa;Web Agent 的输入、状态、日志与输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="web"><mxGeometry x="15" y="109" width="215" height="58" as="geometry"/></mxCell>
        <mxCell id="formula" value="custom_formulas&#xa;自定义公式的管理信息&#xa;当前不参与指标计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="web"><mxGeometry x="15" y="182" width="215" height="62" as="geometry"/></mxCell>
        <mxCell id="alerts" value="alerts / alert_history&#xa;规则、检查结果与发送记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="web"><mxGeometry x="15" y="259" width="215" height="52" as="geometry"/></mxCell>
        <mxCell id="internal" value="待接入的内部营运数据（规划）&#xa;POS 销售、合同租金、店前客流、会员消费、客诉巡检&#xa;接入后才能计算真实坪效、租售比、同店销售与租户经营健康度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="305" y="535" width="520" height="90" as="geometry"/></mxCell>
        <mxCell id="output" value="当前可回答的问题&#xa;• 某商场/品类有哪些门店，公开口碑与热度怎样？&#xa;• 同商场门店的评价声量份额怎样？&#xa;• 近期公开口碑、评论、笔记数据有什么变化？&#xa;不能直接回答：某店真实销售、坪效、租售比或合同风险。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="875" y="535" width="385" height="90" as="geometry"/></mxCell>
