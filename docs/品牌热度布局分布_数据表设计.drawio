  <diagram id="brandpulse-product-data-model" name="产品化数据模型与血缘">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BrandPulse 产品化数据模型、数据血缘与事实边界（2026-08-10）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="18" width="780" height="34" as="geometry"/></mxCell>
        <mxCell id="note" value="公开平台数据用于口碑、热度和竞争线索；内部经营数据单独接入、单独治理。没有内部数据时，系统不得生成销售、坪效、租售比或合同风险结论。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="160" y="55" width="1280" height="26" as="geometry"/></mxCell>

        <mxCell id="scope" value="1. 主数据与监测范围" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="105" width="315" height="530" as="geometry"/></mxCell>
        <mxCell id="category" value="category_dict&#xa;业态 / 品类 / 细分分类&#xa;受控字典，不由采集结果自动创建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="scope"><mxGeometry x="18" y="44" width="279" height="64" as="geometry"/></mxCell>
        <mxCell id="companies" value="companies&#xa;公司 / 商业项目主体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="scope"><mxGeometry x="18" y="122" width="279" height="50" as="geometry"/></mxCell>
        <mxCell id="malls" value="malls&#xa;城市、商圈、项目、坐标、是否本方项目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="scope"><mxGeometry x="18" y="186" width="279" height="58" as="geometry"/></mxCell>
        <mxCell id="brands" value="brands&#xa;品牌档案、品类、定位、价格带、拓店状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="scope"><mxGeometry x="18" y="258" width="279" height="58" as="geometry"/></mxCell>
        <mxCell id="stores" value="stores&#xa;门店、品牌、城市、项目、地址、经纬度、状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="scope"><mxGeometry x="18" y="330" width="279" height="58" as="geometry"/></mxCell>
        <mxCell id="scope-table" value="monitoring_scopes&#xa;城市 × 项目 × 品类 × 数据集 ID&#xa;所有采集、看板、报告都必须绑定 scope_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="scope"><mxGeometry x="18" y="402" width="279" height="74" as="geometry"/></mxCell>

        <mxCell id="control" value="2. 采集控制、来源与治理台账" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="385" y="105" width="345" height="530" as="geometry"/></mxCell>
        <mxCell id="crawl-schedules" value="crawl_schedules&#xa;自动采集计划、执行时间、启停、重试上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="control"><mxGeometry x="18" y="44" width="309" height="58" as="geometry"/></mxCell>
        <mxCell id="crawl-jobs" value="crawl_jobs&#xa;手动 / 计划采集任务、RQ job、状态、来源结果摘要&#xa;pending → running → completed / failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="control"><mxGeometry x="18" y="116" width="309" height="76" as="geometry"/></mxCell>
        <mxCell id="source-logs" value="data_source_logs&#xa;来源、批次、trace_id、实体、开始结束时间、metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="control"><mxGeometry x="18" y="206" width="309" height="64" as="geometry"/></mxCell>
        <mxCell id="aliases" value="brand_aliases / store_aliases&#xa;外部名称标准化、人工确认、匹配置信度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="control"><mxGeometry x="18" y="284" width="309" height="64" as="geometry"/></mxCell>
        <mxCell id="quality" value="data_quality_issues / scan_runs&#xa;质量问题、严重级别、确认 / 解决状态&#xa;问题不解决时不进入高风险业务结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="control"><mxGeometry x="18" y="362" width="309" height="76" as="geometry"/></mxCell>
        <mxCell id="raw-lineage" value="数据血缘最低字段&#xa;source_name · scope_id · crawl_job_id · captured_at · 原始键 · quality_status" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="control"><mxGeometry x="18" y="456" width="309" height="38" as="geometry"/></mxCell>

        <mxCell id="raw-data" value="3. 原始事实数据层" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="765" y="105" width="370" height="530" as="geometry"/></mxCell>
        <mxCell id="dp" value="dp_shop_metrics&#xa;点评门店评分、评价数、人均、项目、采集日&#xa;主键：shop + city + crawl_date + dataset + place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="raw-data"><mxGeometry x="18" y="44" width="334" height="76" as="geometry"/></mxCell>
        <mxCell id="xhs" value="xhs_notes&#xa;小红书笔记、作者、点赞、发布时间、关键词、采集日&#xa;主键：note_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="raw-data"><mxGeometry x="18" y="134" width="334" height="70" as="geometry"/></mxCell>
        <mxCell id="brand-metrics" value="brand_metrics&#xa;历史品牌平台指标兼容表&#xa;逐步由规范化事实与指标表承接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="raw-data"><mxGeometry x="18" y="218" width="334" height="58" as="geometry"/></mxCell>
        <mxCell id="operations" value="store_operations（内部经营数据，规划）&#xa;销售、订单、客流、租金、面积、合同日期、坪效、租售比&#xa;上传校验通过后才可进入内部经营分析" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f8f8;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="raw-data"><mxGeometry x="18" y="290" width="334" height="82" as="geometry"/></mxCell>
        <mxCell id="raw-cache" value="原始快照&#xa;开发：data/raw、data/processed&#xa;生产：对象存储 / MinIO，按批次保留与清理" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f8f8;strokeColor=#82b366;" vertex="1" parent="raw-data"><mxGeometry x="18" y="386" width="334" height="70" as="geometry"/></mxCell>

        <mxCell id="derived-data" value="4. 聚合、指标与解释层" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="105" width="380" height="530" as="geometry"/></mxCell>
        <mxCell id="heat" value="brand_heat_daily&#xa;平台 × 日期 × 城市 × 项目 × 数据集&#xa;提及、点赞、点评评价数、门店数、人均" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="derived-data"><mxGeometry x="18" y="44" width="344" height="70" as="geometry"/></mxCell>
        <mxCell id="indicators" value="brand_indicators_daily&#xa;门店 / 商场级：口碑、热度、SOV、动量、波动率&#xa;detail 保留原始值、参数和中间结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="derived-data"><mxGeometry x="18" y="128" width="344" height="76" as="geometry"/></mxCell>
        <mxCell id="legacy-indicators" value="indicators&#xa;品牌维度时序兼容读取&#xa;禁止成为新的事实源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="derived-data"><mxGeometry x="18" y="218" width="344" height="54" as="geometry"/></mxCell>
        <mxCell id="formulas" value="custom_formulas / custom_formula_values&#xa;安全表达式、版本、参数、计算结果&#xa;公式计算必须绑定指标快照日期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="derived-data"><mxGeometry x="18" y="286" width="344" height="64" as="geometry"/></mxCell>
        <mxCell id="health" value="经营健康度（规划）&#xa;销售趋势 · 坪效 · 租售比 · 客流转化 · 合同风险&#xa;仅使用已授权且治理通过的内部数据" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="derived-data"><mxGeometry x="18" y="364" width="344" height="76" as="geometry"/></mxCell>
        <mxCell id="metric-contract" value="指标契约：名称、口径、单位、版本、数据范围、质量门禁、解释字段" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="derived-data"><mxGeometry x="18" y="458" width="344" height="36" as="geometry"/></mxCell>

        <mxCell id="product-tables" value="5. 产品运行台账与输出" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="700" width="720" height="270" as="geometry"/></mxCell>
        <mxCell id="agent-tasks" value="agent_tasks&#xa;输入、上下文、RQ job、状态、尝试次数、日志、输出&#xa;Agent 只读查询或触发受控任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="product-tables"><mxGeometry x="18" y="44" width="330" height="74" as="geometry"/></mxCell>
        <mxCell id="alerts" value="alerts / alert_history&#xa;规则、指标值、触发结果、通知发送记录&#xa;SMTP / Webhook 配置缺失时只留检查历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="product-tables"><mxGeometry x="372" y="44" width="330" height="74" as="geometry"/></mxCell>
        <mxCell id="reports" value="report_runs / report_schedules&#xa;数据新鲜度门禁、快照日期、文件、行数、错误&#xa;报告不能把过期数据包装成当日结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="product-tables"><mxGeometry x="18" y="136" width="330" height="74" as="geometry"/></mxCell>
        <mxCell id="ml-tables" value="ml_dataset_uploads / ml_training_runs&#xa;ml_forecast_exports / ml_operation_logs&#xa;数据输入、训练、回测、导出全链路可追溯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="product-tables"><mxGeometry x="372" y="136" width="330" height="74" as="geometry"/></mxCell>
        <mxCell id="output-boundary" value="输出边界：看板 / API / CSV / XLSX / 告警 / Agent 回答都必须带 scope、日期、来源和质量状态。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="product-tables"><mxGeometry x="18" y="226" width="684" height="22" as="geometry"/></mxCell>

        <mxCell id="future-layer" value="6. 后续产品化实体（规划，不得画成当前已完成）" style="swimlane;html=1;rounded=1;startSize=28;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="795" y="700" width="755" height="270" as="geometry"/></mxCell>
        <mxCell id="rbac" value="organizations / users / roles / permissions&#xa;组织隔离、项目授权、敏感字段脱敏" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="future-layer"><mxGeometry x="18" y="44" width="230" height="64" as="geometry"/></mxCell>
        <mxCell id="knowledge" value="knowledge_documents / knowledge_chunks&#xa;制度、合同条款、行业报告、来源引用&#xa;Embedding + 检索增强问答" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="future-layer"><mxGeometry x="262" y="44" width="230" height="64" as="geometry"/></mxCell>
        <mxCell id="model-registry" value="model_registry / model_versions&#xa;训练数据版本、特征版本、模型审批&#xa;上线 / 回滚 / 漂移监控" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="future-layer"><mxGeometry x="506" y="44" width="230" height="64" as="geometry"/></mxCell>
        <mxCell id="data-contract" value="数据契约与审批&#xa;POS / CRM / 客流 / 合同连接器&#xa;导入校验、审批、回溯、删除与留存策略" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="future-layer"><mxGeometry x="18" y="134" width="230" height="64" as="geometry"/></mxCell>
        <mxCell id="audit" value="audit_events&#xa;谁在何时查看、导出、修改、运行了什么&#xa;与 trace_id 关联" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="future-layer"><mxGeometry x="262" y="134" width="230" height="64" as="geometry"/></mxCell>
        <mxCell id="lakehouse" value="数据平台化&#xa;对象存储原始层 + 分区归档 + 数据质量报表&#xa;为多项目、多租户扩展做准备" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="future-layer"><mxGeometry x="506" y="134" width="230" height="64" as="geometry"/></mxCell>
        <mxCell id="legend" value="图例：蓝色 = 主数据 / 产品输出；绿色 = 原始事实；黄色 = 派生指标；紫色 = 运行台账；虚线灰框 = 尚未完成的产品化能力。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="future-layer"><mxGeometry x="18" y="222" width="718" height="22" as="geometry"/></mxCell>

        <mxCell id="e-category-brand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="category" target="brands"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-brand-store" value="品牌拥有门店" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="brands" target="stores"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-mall-store" value="项目内门店" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="malls" target="stores"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-scope-control" value="计划绑定范围" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="scope-table" target="crawl-schedules"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-schedule-job" value="入队 / 领取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="crawl-schedules" target="crawl-jobs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-job-log" value="批次与来源日志" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="crawl-jobs" target="source-logs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-raw-dp" value="点评采集写入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="source-logs" target="dp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-raw-xhs" value="小红书采集写入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="source-logs" target="xhs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-match" value="名称匹配与质量问题" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="aliases" target="quality"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-dp-heat" value="按日期 / 项目 / 平台聚合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="dp" target="heat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-xhs-heat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="xhs" target="heat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-heat-indicators" value="确定性指标管道" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="heat" target="indicators"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ind-legacy" value="兼容同步" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="indicators" target="legacy-indicators"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ind-formula" value="公式上下文" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="indicators" target="formulas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-operation-health" value="内部经营数据通过门禁后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="operations" target="health"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ind-alert" value="规则取最新可信值" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="indicators" target="alerts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ind-report" value="报告快照门禁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="indicators" target="reports"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ops-ml" value="内部标签 / 特征" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="operations" target="ml-tables"><mxGeometry relative="1" as="geometry"/></mxCell>
