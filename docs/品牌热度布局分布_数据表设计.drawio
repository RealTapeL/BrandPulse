                <mxCell id="dist-body" value="brand_id｜city｜mall_name｜shop_count&#10;&#10;SQL：SELECT brand_id, city, mall_name, COUNT(*)&#10;FROM stores WHERE store_status != '闭店'&#10;GROUP BY brand_id, city, mall_name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
