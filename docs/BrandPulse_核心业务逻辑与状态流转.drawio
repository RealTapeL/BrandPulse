<mxfile host="app.diagrams.net" modified="2026-08-10T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="brandpulse-core-workflows" name="核心业务逻辑与状态流转">
    <mxGraphModel dx="1900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BrandPulse 核心业务逻辑与状态流转（产品化版）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="18" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="note" value="核心原则：先登记监测范围，再采集真实数据；先做质量与血缘，再计算指标；报告、告警、Agent 和 ML 都只能消费有来源、有日期、有质量状态的数据。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="180" y="55" width="1340" height="26" as="geometry"/></mxCell>

        <mxCell id="lane-monitoring" value="A. 公开数据监测主链路（当前已可运行）" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1640" height="330" as="geometry"/></mxCell>
        <mxCell id="a1" value="配置监测范围&#xa;城市 + 项目 + 品类 + 数据集 ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane-monitoring"><mxGeometry x="20" y="60" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="a2" value="手动采集 / 自动计划&#xa;明确 source、时间、重试上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lane-monitoring"><mxGeometry x="245" y="60" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="a3" value="创建 crawl_jobs&#xa;持久化后投递 brandpulse-crawl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="lane-monitoring"><mxGeometry x="470" y="60" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="a4" value="RQ Worker 执行&#xa;来源级 success / empty / failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="lane-monitoring"><mxGeometry x="695" y="60" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="a5" value="WebBridge / API Connector&#xa;点评 · 小红书 · 高德" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane-monitoring"><mxGeometry x="920" y="60" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="a6" value="原始数据入库 + 快照&#xa;保存来源、批次、时间、原始键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane-monitoring"><mxGeometry x="1145" y="60" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="a7" value="质量扫描与名称匹配&#xa;未确认记录保留问题，不强行归属" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="lane-monitoring"><mxGeometry x="1370" y="60" width="235" height="72" as="geometry"/></mxCell>
        <mxCell id="a8" value="任何来源取得可验证记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane-monitoring"><mxGeometry x="470" y="185" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="a9" value="全部来源为空或失败&#xa;任务 failed；按上限延迟重试&#xa;不得把空结果标记为成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="lane-monitoring"><mxGeometry x="760" y="175" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="a10" value="部分来源为空 / 失败&#xa;保留已采到数据；任务与计划记录 warning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="lane-monitoring"><mxGeometry x="1090" y="175" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="a11" value="重试上限耗尽 / 入队失败&#xa;记录 last_error，等待人工处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;" vertex="1" parent="lane-monitoring"><mxGeometry x="1415" y="175" width="190" height="74" as="geometry"/></mxCell>
        <mxCell id="a12" value="crawl_jobs 状态：pending → running → completed / failed；重试期间为 retry_pending。计划通过 last_enqueued_for 与数据库原子领取保证幂等。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="lane-monitoring"><mxGeometry x="20" y="275" width="1585" height="22" as="geometry"/></mxCell>

        <mxCell id="lane-metrics" value="B. 指标、告警与报告链路" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="465" width="1040" height="325" as="geometry"/></mxCell>
        <mxCell id="b1" value="读取最新可信原始事实&#xa;按 scope_id 和 stat_date 限定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lane-metrics"><mxGeometry x="20" y="62" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="b2" value="确定性指标管道&#xa;口碑 · 热度 · SOV · 趋势&#xa;写 detail 与公式版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="lane-metrics"><mxGeometry x="245" y="62" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="b3" value="指标快照可解释&#xa;数据日期、样本量、质量状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lane-metrics"><mxGeometry x="470" y="62" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="b4" value="告警调度&#xa;取真实指标或经营字段&#xa;写 alert_history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="lane-metrics"><mxGeometry x="695" y="62" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="报告数据新鲜度门禁&#xa;默认不超过 72 小时&#xa;不满足则 skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="lane-metrics"><mxGeometry x="870" y="62" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="b6" value="规则触发？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="lane-metrics"><mxGeometry x="260" y="185" width="130" height="70" as="geometry"/></mxCell>
        <mxCell id="b7" value="否：记录正常检查历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;" vertex="1" parent="lane-metrics"><mxGeometry x="20" y="190" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="b8" value="是：去重 / 抑制 / 通知&#xa;SMTP 或 Webhook 未配置时只记录未发送原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;" vertex="1" parent="lane-metrics"><mxGeometry x="430" y="180" width="250" height="74" as="geometry"/></mxCell>
        <mxCell id="b9" value="报告成功&#xa;XLSX：摘要 + 指标 + 来源明细&#xa;CSV：指标快照；记录下载路径与行数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;" vertex="1" parent="lane-metrics"><mxGeometry x="720" y="180" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="b10" value="计划报告：每日 / 每周；只有显式启用且门禁通过才入队。报告生成失败、跳过、下载均保留 report_runs。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="lane-metrics"><mxGeometry x="20" y="278" width="1000" height="22" as="geometry"/></mxCell>

        <mxCell id="lane-agent" value="C. Agent 对话与后台任务链路（当前已具备，生产需强化权限）" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="465" width="560" height="325" as="geometry"/></mxCell>
        <mxCell id="c1" value="用户问题 / 操作指令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="lane-agent"><mxGeometry x="20" y="62" width="155" height="56" as="geometry"/></mxCell>
        <mxCell id="c2" value="LLM 解析意图&#xa;选择只读查询或受控工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lane-agent"><mxGeometry x="200" y="62" width="155" height="56" as="geometry"/></mxCell>
        <mxCell id="c3" value="工具层&#xa;list_tables · query_db&#xa;query_brand · run_indicators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane-agent"><mxGeometry x="380" y="62" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="c4" value="start_crawl / 长任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="lane-agent"><mxGeometry x="20" y="170" width="155" height="56" as="geometry"/></mxCell>
        <mxCell id="c5" value="agent_tasks + RQ&#xa;持久化日志、尝试次数、输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="lane-agent"><mxGeometry x="200" y="170" width="155" height="56" as="geometry"/></mxCell>
        <mxCell id="c6" value="回答必须带数据日期、来源、限制&#xa;不得把 Agent-Reach 研究当作核心指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="lane-agent"><mxGeometry x="380" y="160" width="155" height="76" as="geometry"/></mxCell>
        <mxCell id="c7" value="后续：组织权限、敏感字段策略、人工确认、工具超时与审计" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="lane-agent"><mxGeometry x="20" y="270" width="515" height="22" as="geometry"/></mxCell>

        <mxCell id="lane-internal" value="D. 内部经营数据与生产预测链路（后续必须真实落地）" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="825" width="1640" height="300" as="geometry"/></mxCell>
        <mxCell id="d1" value="数据来源&#xa;POS / 合同 / 客流 / 会员 / 巡检&#xa;Excel、API 或数据库连接器" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="lane-internal"><mxGeometry x="20" y="62" width="205" height="76" as="geometry"/></mxCell>
        <mxCell id="d2" value="导入预览与数据契约&#xa;字段、类型、日期、单位、主键、来源" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="lane-internal"><mxGeometry x="260" y="62" width="205" height="76" as="geometry"/></mxCell>
        <mxCell id="d3" value="主数据映射与质量门禁&#xa;品牌 / 门店 / 项目匹配&#xa;缺失、重复、越界、敏感字段检查" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;" vertex="1" parent="lane-internal"><mxGeometry x="500" y="62" width="205" height="76" as="geometry"/></mxCell>
        <mxCell id="d4" value="人工确认 / 审批&#xa;通过才写 store_operations&#xa;失败进入问题台账，不污染事实表" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="lane-internal"><mxGeometry x="740" y="62" width="205" height="76" as="geometry"/></mxCell>
        <mxCell id="d5" value="经营指标层&#xa;同店销售、坪效、租售比、客流转化&#xa;合同到期与租户健康度" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;" vertex="1" parent="lane-internal"><mxGeometry x="980" y="62" width="205" height="76" as="geometry"/></mxCell>
        <mxCell id="d6" value="ML 资格门禁&#xa;授权内部数据 + 稳定回测 + 模型审批&#xa;才允许 production_eligible=true" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="lane-internal"><mxGeometry x="1220" y="62" width="205" height="76" as="geometry"/></mxCell>
        <mxCell id="d7" value="预测服务与决策输出&#xa;预测区间、误差、模型版本、数据日期&#xa;支持导出、复盘、回滚" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="lane-internal"><mxGeometry x="1460" y="62" width="155" height="76" as="geometry"/></mxCell>
        <mxCell id="d8" value="禁止路径：公开点评 / 小红书评价 → 直接推断 POS 销售或租户盈利；公开基准模型 → 直接用于内部经营决策。" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff0f0;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="lane-internal"><mxGeometry x="20" y="190" width="1595" height="54" as="geometry"/></mxCell>

        <mxCell id="e-a1-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a2-a3" value="创建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a3-a4" value="RQ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a4-a5" value="执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a5-a6" value="成功来源写入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a6-a7" value="扫描" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a7-a8" value="有记录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a7-a9" value="全空 / 全失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a7" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a7-a10" value="部分来源失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a7" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a9-a11" value="重试耗尽" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a9" target="a11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a8-b1" value="刷新指标" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a8" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b1-b2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b2-b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b3-b4" value="定时检查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b3-b5" value="生成报告" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b4-b6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b4" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b6-b7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b6-b8" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b6" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-b5-b9" value="门禁通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b5" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c1-c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c2-c3" value="工具调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c3-c4" value="长任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c4-c5" value="入队" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-c3-c6" value="查询结果 / 解释" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d1-d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d2-d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d3-d4" value="待人工确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d4-d5" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d5-d6" value="特征 / 标签" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d6-d7" value="审批通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell>
