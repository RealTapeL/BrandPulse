        <mxCell id="dim-1" value="&lt;b&gt;档次维度&lt;/b&gt;&lt;br&gt;国际精品 / 轻奢 / 快时尚 / 大众 / 平价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=11;" vertex="1" parent="1">
