          <mxGeometry x="70" y="1240" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dim-5" value="&lt;b&gt;区域偏好&lt;/b&gt;&lt;br&gt;一线城市 / 新一线 / 二三线 / 下沉市场" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=11;" vertex="1" parent="1">
