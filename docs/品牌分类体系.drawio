        <mxCell id="dim-title" value="📌 品牌分类的补充维度（标签体系）" style="text;html=1;strokeColor=none;fillColor=#1E293B;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;spacing=8;" vertex="1" parent="1">
