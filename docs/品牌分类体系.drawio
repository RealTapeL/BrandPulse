        <!-- ==================== 右侧说明：优化点 ==================== -->
        <mxCell id="note-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="1100" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="note-title" value="⚠️ 相比原方案的主要优化点" style="text;html=1;strokeColor=none;fillColor=#991B1B;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="1115" width="480" height="35" as="geometry" />
        </mxCell>

        <mxCell id="note-1" value="&lt;b&gt;1. 消除交叉重复&lt;/b&gt;&lt;br&gt;原方案中'超级猩猩'同时出现在快餐和健身，已修正到健身。\n火锅、烧烤从'正餐'和'特色美食'合并统一。" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#334155;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="1160" width="480" height="55" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;2. 层级统一为3-4级&lt;/b&gt;&lt;br&gt;业态(一级) → 品类(二级) → 细分(三级) → 品牌示例。\n避免有的分支过深、有的过浅。" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#334155;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="1220" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;3. 餐饮分类更清晰&lt;/b&gt;&lt;br&gt;正餐(含火锅/烧烤) / 快餐轻食 / 休闲餐饮 / 美食广场，\n避免'绿茶'被误放到日韩式。" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#334155;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="1275" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="&lt;b&gt;4. 增加补充维度标签&lt;/b&gt;&lt;br&gt;档次/品牌级别/经营方式/拓店状态/客群标签/主力店标签，\n这些不是分类树，而是每个品牌的属性标签。" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#334155;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="1330" width="480" height="55" as="geometry" />
        </mxCell>

        <!-- 底部备注 -->
        <mxCell id="bottom-note" value="注：分类体系建议先按项目定位做微调。高端商场与国际精品/轻奢/美妆相关度高；社区商场则更关注生活服务、快餐、儿童业态。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#64748B;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1410" width="1300" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
