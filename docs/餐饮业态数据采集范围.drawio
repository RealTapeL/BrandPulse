<mxfile host="app.diagrams.net" modified="2026-08-10T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="brandpulse-data-source-scope" name="数据源与产品能力边界">
    <mxGraphModel dx="1750" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BrandPulse 餐饮数据源、采集优先级与能力边界（产品化版）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="18" width="840" height="34" as="geometry"/></mxCell>
        <mxCell id="note" value="优先级不是“越多越好”，而是按业务问题、授权条件、稳定性、可验证性和维护成本决定。当前先跑通公开监测闭环，内部经营数据接入后再开放经营健康度和生产预测。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="55" width="1260" height="26" as="geometry"/></mxCell>

        <mxCell id="p0" value="P0 当前可运行：公开监测闭环" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="105" width="465" height="635" as="geometry"/></mxCell>
        <mxCell id="p0-q" value="问题：项目 / 品类有哪些门店？公开口碑和热度如何？&#xa;可输出：门店明细、评分、评价数、人均、笔记、点赞、SOV、趋势&#xa;不能输出：真实销售、坪效、租售比、合同风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="p0"><mxGeometry x="18" y="46" width="429" height="84" as="geometry"/></mxCell>
        <mxCell id="p0-dp" value="大众点评 + WebBridge&#xa;当前已跑通真实采集&#xa;评分 / 评价数 / 人均 / 门店 / 项目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p0"><mxGeometry x="18" y="152" width="205" height="82" as="geometry"/></mxCell>
        <mxCell id="p0-xhs" value="小红书 + WebBridge&#xa;当前已跑通真实采集&#xa;笔记 / 点赞 / 发布时间 / 关键词" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p0"><mxGeometry x="242" y="152" width="205" height="82" as="geometry"/></mxCell>
        <mxCell id="p0-amap" value="高德地图 API&#xa;门店 POI / 城市 / 坐标&#xa;用于门店主数据补充" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="p0"><mxGeometry x="18" y="256" width="205" height="70" as="geometry"/></mxCell>
        <mxCell id="p0-pipe" value="统一采集管道&#xa;scope → crawl_job → RQ → extractor → 原始表 / JSON → 治理 → 指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="p0"><mxGeometry x="242" y="256" width="205" height="70" as="geometry"/></mxCell>
        <mxCell id="p0-rule" value="上线规则&#xa;每个来源必须记录 success / empty / failed；全部为空不算成功；部分来源失败要显式告警。&#xa;浏览器登录态、验证码和平台规则是外部依赖。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="p0"><mxGeometry x="18" y="350" width="429" height="92" as="geometry"/></mxCell>
        <mxCell id="p0-out" value="现阶段产品输出&#xa;看板 / 品牌详情 / 数据表 / 指标公式 / 告警检查历史 / CSV 与 XLSX 快照 / Agent 查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p0"><mxGeometry x="18" y="466" width="429" height="84" as="geometry"/></mxCell>
        <mxCell id="p0-status" value="状态：当前真实数据链路已验证；需要持续运行、来源稳定性、告警通知和人工治理确认。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="p0"><mxGeometry x="18" y="578" width="429" height="24" as="geometry"/></mxCell>

        <mxCell id="p1" value="P1 后续必须接入：内部经营数据" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="535" y="105" width="465" height="635" as="geometry"/></mxCell>
        <mxCell id="p1-source" value="数据源&#xa;POS 销售 / 订单&#xa;租赁合同 / 租金 / 面积&#xa;店前客流 / 会员消费&#xa;客诉与运营巡检&#xa;招商联系记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p1"><mxGeometry x="18" y="46" width="429" height="112" as="geometry"/></mxCell>
        <mxCell id="p1-contract" value="接入前数据契约&#xa;字段、单位、日期粒度、主键、门店映射、权限、保留周期&#xa;Excel 只能作为过渡，稳定后应替换为 API / 数据库连接器" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f8f8;strokeColor=#999999;" vertex="1" parent="p1"><mxGeometry x="18" y="180" width="429" height="84" as="geometry"/></mxCell>
        <mxCell id="p1-govern" value="质量与审批&#xa;品牌 / 门店 / 项目匹配&#xa;缺失、重复、异常值、敏感字段扫描&#xa;业务负责人确认后才能入 store_operations" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f8f8;strokeColor=#999999;" vertex="1" parent="p1"><mxGeometry x="18" y="286" width="429" height="94" as="geometry"/></mxCell>
        <mxCell id="p1-metrics" value="新增经营指标&#xa;同店销售趋势 / 客单价 / 坪效 / 租售比&#xa;客流转化 / 合同到期 / 租户经营健康度" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="18" y="402" width="429" height="82" as="geometry"/></mxCell>
        <mxCell id="p1-ml" value="只有满足授权、质量、样本量和回测标准后，内部数据才可用于生产预测模型；公开数据模型只能作为 benchmark。" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff0f0;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="18" y="506" width="429" height="72" as="geometry"/></mxCell>
        <mxCell id="p1-status" value="状态：代码已有 Excel 预览 / 导入入口和 store_operations 表，但尚无真实内部数据。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="p1"><mxGeometry x="18" y="602" width="429" height="20" as="geometry"/></mxCell>

        <mxCell id="p2" value="P2 探索扩展：外部深度数据" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1035" y="105" width="465" height="635" as="geometry"/></mxCell>
        <mxCell id="p2-source" value="候选来源&#xa;地图 / 品牌官网 / 公众号&#xa;微博 / 行业报告 / 竞品商场调研&#xa;美团 / 饿了么 / 抖音本地生活&#xa;新闻 / 招聘 / 投融资 / 人口交通" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p2"><mxGeometry x="18" y="46" width="429" height="112" as="geometry"/></mxCell>
        <mxCell id="p2-gate" value="接入评估门禁&#xa;授权与合规 · 获取稳定性 · 维护成本&#xa;字段可验证性 · 更新频率 · 业务问题是否明确" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;" vertex="1" parent="p2"><mxGeometry x="18" y="180" width="429" height="84" as="geometry"/></mxCell>
        <mxCell id="p2-research" value="Agent-Reach&#xa;只做公开网页读取 / 搜索辅助&#xa;保留 URL、标题、发布时间和引用&#xa;不直接写入品牌指标或经营表" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;" vertex="1" parent="p2"><mxGeometry x="18" y="286" width="205" height="92" as="geometry"/></mxCell>
        <mxCell id="p2-new" value="新增连接器&#xa;必须复用 source adapter、限流、重试、原始快照、治理和血缘&#xa;不能在前端直接请求第三方平台" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;" vertex="1" parent="p2"><mxGeometry x="242" y="286" width="205" height="92" as="geometry"/></mxCell>
        <mxCell id="p2-out" value="可形成的能力&#xa;品牌布局 / 行业趋势 / 竞争线索 / 招商研究&#xa;研究结论必须与内部经营事实分层展示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="p2"><mxGeometry x="18" y="402" width="429" height="82" as="geometry"/></mxCell>
        <mxCell id="p2-status" value="状态：按业务价值逐个接入；不建议一次性接入所有平台。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="p2"><mxGeometry x="18" y="602" width="429" height="20" as="geometry"/></mxCell>

        <mxCell id="decision" value="统一落地决策门" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="35" y="780" width="1465" height="190" as="geometry"/></mxCell>
        <mxCell id="d1" value="1. 能回答明确业务问题？" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="decision"><mxGeometry x="18" y="54" width="220" height="54" as="geometry"/></mxCell>
        <mxCell id="d2" value="2. 有合法、稳定、可持续的获取方式？" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="decision"><mxGeometry x="270" y="54" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="d3" value="3. 能与项目 / 品牌 / 门店主数据匹配？" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="decision"><mxGeometry x="562" y="54" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="d4" value="4. 能保留来源、日期、质量和版本？" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="decision"><mxGeometry x="854" y="54" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="d5" value="5. 经过连续运行与业务验收？" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="decision"><mxGeometry x="1146" y="54" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="d6" value="任一项不满足：停留在研究 / 待确认状态，不进入生产结论。全部满足：登记数据源、连接器、数据契约、质量门禁、监控计划和负责人。" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff0f0;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="decision"><mxGeometry x="18" y="132" width="1388" height="36" as="geometry"/></mxCell>
        <mxCell id="e-d1-d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d2-d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d3-d4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-d4-d5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
